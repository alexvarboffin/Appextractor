<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lLayout1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#EBF3F9"
    android:gravity="center"
    android:weightSum="2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/overflowMenu"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:weightSum="2">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_item_key" />

            <TextView
                android:id="@+id/text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="@string/app_name" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <!--            <ImageView-->
            <!--                android:layout_width="wrap_content"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:contentDescription="@string/app_name"-->
            <!--                android:src="@drawable/ic_value" />-->

            <TextView
                android:id="@+id/text2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:fontFamily="@font/inter_regular"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="#000000"
                android:textSize="14sp"
                tools:text="@string/app_name" />
        </LinearLayout>

    </LinearLayout>


    <ImageView
        android:id="@+id/overflowMenu"
        android:layout_width="72dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/ic_album_overflow_margin_top"
        android:background="@null"
        android:contentDescription="@+id/overflowMenu"
        android:paddingBottom="0dp"
        android:scaleType="fitEnd"
        app:srcCompat="@drawable/ic_dots"
        app:tint="@color/colorPrimary"
        tools:background="@android:color/holo_red_dark"
        tools:ignore="ImageContrastCheck" />

<!--    <ImageView-->
<!--        android:id="@+id/searchBtn"-->
<!--        android:layout_width="32dp"-->
<!--        android:layout_height="32dp"-->
<!--        android:layout_alignParentTop="true"-->
<!--        android:layout_alignParentEnd="true"-->
<!--        android:contentDescription="@null"-->
<!--        android:src="@drawable/bg_nav_item"-->
<!--        android:visibility="gone" />-->

</RelativeLayout>